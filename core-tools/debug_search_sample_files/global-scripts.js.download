function preventDoubleSubmission(event){
	var $form = $(this);
	if($form.data('submitted') == true){
		event.preventDefault();
	}else{
		$form.data('submitted', true);
	}
}

function preventDoubleSubmissionSpinner(event){
	var $form = $(this);
	if($form.data('submitted') == true){
		event.preventDefault();
	}else{
		$form.data('submitted', true);
	}
	
	$("#searchSpinner").removeClass("hidden");
	$("#blocker").removeClass("hidden");
}

function showOrHideRoles(){
	var leftPos = $("#ChangeRoleContainer").css("left");
	
	if(leftPos == "0px"){
		$("#ChangeRoleContainer").css("left", "-380px");
	}else{
		$("#ChangeRoleContainer").css("left", "0px");
	}
}

/*
 * This function will logout the user and reload the page with no credentials
 */
function remoteLogout(){
	var xmlHttp = new XMLHttpRequest();
	xmlHttp.open("GET", "/j_spring_cas_security_logout", true);
	xmlHttp.send();
	xmlHttp.onreadystatechange = function(){
		if(xmlHttp.readyState == 4){
			location.reload();
		}
	}
}

/*This Function deals with the expanding elements with chevrons as indicators*/
function toggleChevron(e){
	$(e).find('i').toggleClass('glyphicon-chevron-down glyphicon-chevron-up');
}

